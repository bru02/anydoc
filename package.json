{
  "name": "@bru02/anydoc",
  "version": "0.2.4-liteparse.3",
  "type": "module",
  "description": "AnyDoc document conversion with LiteParse PDF extraction",
  "license": "MIT",
  "repository": "github:bru02/anydoc",
  "scripts": {
    "test": "bun test ./expo && node --test hybrid/*.test.js",
    "native:build:ios": "bun scripts/build-native.mjs ios",
    "native:build:android": "bun scripts/build-native.mjs android",
    "module:build:ios": "bun scripts/build-module.mjs ios",
    "module:build:android": "bun scripts/build-module.mjs android"
  },
  "exports": {
    ".": {
      "types": "./hybrid/index.d.ts",
      "import": "./hybrid/index.js"
    },
    "./expo": {
      "types": "./expo/index.d.ts",
      "default": "./expo/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@firecrawl/anydoc-wasm": "0.2.4",
    "@llamaindex/liteparse-wasm": "2.17.0"
  },
  "peerDependencies": {
    "expo": ">=55"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "files": [
    "hybrid/*.js",
    "hybrid/*.d.ts",
    "expo/*.js",
    "expo/*.d.ts",
    "expo/README.md",
    "expo-module.config.json",
    "spm.config.json",
    "ios/*.swift",
    "ios/*.podspec",
    "android/build.gradle",
    "android/should-use-publication.gradle",
    "android/consumer-rules.pro",
    "android/src/main/java",
    "android/src/main/AndroidManifest.xml",
    "native/artifacts.json",
    "scripts/fetch-native.rb",
    "scripts/prebuilt-profile.mjs",
    "prebuilds",
    "local-maven-repo",
    "LICENSE"
  ]
}
